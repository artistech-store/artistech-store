# ArtisTech.Store environment variables
# Copy to .env.local for development. NEVER commit .env.local or real keys.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose to the browser, NEVER commit.
# Used exclusively by server-side admin/moderation routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://artistech.store
